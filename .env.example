# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
# Gere um valor forte, por exemplo: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=troque-por-um-segredo-forte
DJANGO_DEBUG=False
DJANGO_LOG_LEVEL=INFO
DJANGO_TIME_ZONE=America/Sao_Paulo

# Hosts e origens confiáveis (separados por vírgula)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Sessão (12 horas; expira também ao fechar o navegador)
DJANGO_SESSION_COOKIE_AGE=43200

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
POSTGRES_DB=uma_voting
POSTGRES_USER=uma_voting
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=db
POSTGRES_PORT=5432
DJANGO_DB_CONN_MAX_AGE=60

# Banco usado por config.settings.staging (testes temporários)
# STAGING_POSTGRES_DB=uma_voting_staging

# ---------------------------------------------------------------------------
# Produção (Caddy)
# ---------------------------------------------------------------------------
DOMAIN=localhost
ACME_EMAIL=
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
# Healthcheck interno de plataforma (Railway) isento de redirect HTTPS.
DJANGO_SECURE_REDIRECT_EXEMPT_HEALTH=False

# ---------------------------------------------------------------------------
# Deploy (Railway / self-host sem Caddy)
# ---------------------------------------------------------------------------
# Estáticos pelo WhiteNoise (True no Railway; False no Compose, onde o Caddy serve).
STATIC_SERVE_WHITENOISE=False
# Headers do Caddy replicados no Django: "proxy" (Caddy/dev) ou "django" (Railway).
SECURITY_HEADERS_MODE=proxy
# Scheduler: "external" (container run_scheduler) ou "on_request" (Railway Free).
DJANGO_SCHEDULER_MODE=external
DJANGO_SCHEDULER_TICK_INTERVAL=60

# ---------------------------------------------------------------------------
# Mídia (filesystem no Compose; S3 no Railway Bucket)
# ---------------------------------------------------------------------------
MEDIA_STORAGE_BACKEND=filesystem
# Origem liberada no CSP para URLs assinadas (https://<bucket>.<endpoint>).
MEDIA_CSP_SOURCE=
# Usadas somente quando MEDIA_STORAGE_BACKEND=s3.
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=auto
AWS_S3_ADDRESSING_STYLE=virtual
AWS_QUERYSTRING_EXPIRE=3600

# ---------------------------------------------------------------------------
# Gunicorn
# ---------------------------------------------------------------------------
GUNICORN_WORKERS=3

# ---------------------------------------------------------------------------
# Importação externa de catálogo e imagens
# ---------------------------------------------------------------------------
# Kill switch: mantenha False para desabilitar o fluxo externo por completo.
EXTERNAL_IMPORT_ENABLED=False
# Timeout (segundos) de conexão/leitura de cada requisição à fonte externa.
EXTERNAL_IMPORT_HTTP_TIMEOUT=15
# Tamanho máximo (bytes) de cada imagem baixada (padrão: 5 MB).
EXTERNAL_IMPORT_MAX_IMAGE_BYTES=5242880
# Downloads simultâneos na fase de imagens.
EXTERNAL_IMPORT_CONCURRENCY=4
# Tempo (segundos) sem heartbeat para considerar uma execução órfã (padrão: 10 min).
EXTERNAL_IMPORT_STALE_SECONDS=600

# ---------------------------------------------------------------------------
# Notas de deploy (Railway)
# ---------------------------------------------------------------------------
# DJANGO_SECURE_REDIRECT_EXEMPT_HEALTH=True: healthcheck interno HTTP é atendido.
# MEDIA_STORAGE_BACKEND=s3 exige as variáveis AWS_* acima preenchidas.
# DJANGO_SCHEDULER_MODE=on_request substitui o serviço `scheduler` no Railway Free.

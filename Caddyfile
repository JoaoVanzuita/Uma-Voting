{$DOMAIN:localhost} {
	encode zstd gzip

	# Estáticos: nomes versionados por hash de conteúdo -> cache longo.
	handle_path /static/* {
		root * /srv/static
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Mídia: acervo local content-addressed, cache de uma semana.
	handle_path /media/* {
		root * /srv/media
		header Cache-Control "public, max-age=604800"
		file_server
	}

	handle {
		# Rate limit de login é aplicado na aplicação (DatabaseCache) por IP/username.
		reverse_proxy web:8000 {
			# Sobrescreve o cabeçalho para que o throttle use o IP real do cliente.
			header_up X-Forwarded-For {remote_host}
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Resource-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	log {
		output stdout
		format console
	}
}
